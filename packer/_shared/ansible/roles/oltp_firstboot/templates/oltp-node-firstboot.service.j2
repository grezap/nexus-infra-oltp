[Unit]
Description=oltp-node firstboot (NIC discovery, hostname mapping, VMnet10 backplane, node-identity env)
After=systemd-networkd.service network-online.target
Wants=network-online.target
# No Before= for the role services -- firstboot does NOT enable any Redis
# service (redis.conf needs per-host cluster-announce-ip rendered by the
# Terraform role-overlays). The role-overlays enable nexus-redis.service
# per-node post-apply.
ConditionPathExists=!/var/lib/oltp-node-firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/oltp-node-firstboot.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
