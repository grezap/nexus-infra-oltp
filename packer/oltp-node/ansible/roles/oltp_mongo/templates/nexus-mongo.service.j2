[Unit]
Description=Nexus MongoDB (replica set member)
Documentation=https://www.mongodb.com/docs/manual/replication/
After=network-online.target oltp-node-firstboot.service
Wants=network-online.target
Requires=oltp-node-firstboot.service
# Delivered DISABLED by the oltp_mongo Packer role. role-overlay-mongo-
# config.tf renders {{ oltp_node_mongo_config_dir }}/mongod.conf (and
# role-overlay-mongo-tls.tf has already rendered server.pem + ca.crt +
# keyfile via the Vault Agent), then enables + starts this unit.
ConditionPathExists={{ oltp_node_mongo_config_dir }}/mongod.conf
# StartLimit* in [Unit] per systemd.unit(5) (the 0.G.1 ratification
# lesson). Generous limits so a slow-to-form replica set doesn't make
# systemd give up -- mirrors vault-transit-boot-race + kafka KRaft
# controller-quorum + redis cluster-bus rejoin lessons.
StartLimitBurst=15
StartLimitIntervalSec=600

[Service]
# Type=simple (NOT notify): mongod CAN integrate with systemd notify via
# `systemLog.systemdNotify: true` in mongod.conf, but that's brittle on
# slow first-boot. The 3c role-overlay-mongo-config.tf has its own
# mongosh ping readiness probe. simple is safe + sufficient. (Same
# shape as nexus-redis.service.)
Type=simple
User={{ oltp_node_mongo_user }}
Group={{ oltp_node_mongo_group }}
EnvironmentFile=-{{ oltp_node_mongo_config_dir }}/node-identity.env
ExecStart=/usr/bin/mongod --config {{ oltp_node_mongo_config_dir }}/mongod.conf
# No ExecStop= -- SIGTERM is graceful for mongod (flushes WT journal,
# closes connections cleanly). `mongosh --eval "db.adminCommand({
# shutdown: 1})"` would need the TLS flags + sudo for the 0640 cert
# files, which is brittle in a stop path.
Restart=on-failure
RestartSec=10
# RuntimeDirectory= -- systemd auto-creates /run/nexus-mongo on every
# service start (per memory/feedback_systemd_runtime_directory_tmpfs.md;
# /var/run is tmpfs and an install-time mkdir does not survive reboot).
# mongod.conf points pidFilePath here.
RuntimeDirectory=nexus-mongo
RuntimeDirectoryMode=0755
LimitNOFILE=64000
LimitNPROC=64000
# WT cache is sized at 0.5 GB in mongod.conf for the lab 2 GB nodes.
TasksMax=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
